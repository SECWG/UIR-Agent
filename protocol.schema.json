{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wg-ir.example/endpoint-agent/protocol-v1.schema.json",
  "title": "UIR terminal protocol v1",
  "description": "Task control and optional management messages. Run messages use encoded_run with a Base64 UTF-8 JSON command and a product marker; run describes decoded tasks for storage and validation only. Interactive terminal bytes use wg-ir.terminal.v1; SSH relay bytes use wg-ir.relay.v1 when hello.relay is true. Both use independent authenticated WebSockets.",
  "$defs": {
    "connection_ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instance_id"],
      "properties": {
        "type": { "const": "connection_ready" },
        "instance_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "relay_open": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id"],
      "properties": {
        "type": { "const": "relay_open" },
        "session_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "relay_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id", "error"],
      "properties": {
        "type": { "const": "relay_error" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "error": {
          "enum": [
            "RELAY_UNAVAILABLE",
            "RELAY_BUSY",
            "RELAY_CONNECT_FAILED",
            "RELAY_CONNECT_TIMEOUT",
            "RELAY_CONNECTION_LOST"
          ]
        }
      }
    },
    "shutdown_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "shutdown_request" },
        "id": { "$ref": "#/$defs/uuid" }
      }
    },
    "shutdown_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "result"],
      "properties": {
        "type": { "const": "shutdown_response" },
        "id": { "$ref": "#/$defs/uuid" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted"],
          "properties": { "accepted": { "const": true } }
        }
      }
    },
    "uninstall_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "receipt_token"],
      "properties": {
        "type": { "const": "uninstall_request" },
        "id": { "type": "string", "format": "uuid" },
        "receipt_token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    },
    "uninstall_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "uninstall_response" },
        "id": { "type": "string", "format": "uuid" },
        "error": { "type": "string", "pattern": "^[A-Z_]{1,64}$" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted"],
          "properties": { "accepted": { "const": true } }
        }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ]
    },
    "hostString": {
      "type": ["string", "null"],
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "hostNumber": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hostInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "osName",
        "osVersion",
        "kernel",
        "arch",
        "account",
        "privilege",
        "uptimeSeconds",
        "systemTime",
        "timezone",
        "cpu",
        "memory",
        "disks",
        "interfaces"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "osName": { "$ref": "#/$defs/hostString" },
        "osVersion": { "$ref": "#/$defs/hostString" },
        "kernel": { "$ref": "#/$defs/hostString" },
        "arch": { "$ref": "#/$defs/hostString" },
        "account": { "$ref": "#/$defs/hostString" },
        "privilege": { "enum": ["root", "administrator", "user", null] },
        "uptimeSeconds": { "$ref": "#/$defs/hostNumber" },
        "systemTime": { "$ref": "#/$defs/hostString" },
        "timezone": { "$ref": "#/$defs/hostString" },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "logicalCores"],
          "properties": {
            "model": { "$ref": "#/$defs/hostString" },
            "logicalCores": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalBytes", "availableBytes"],
          "properties": {
            "totalBytes": { "$ref": "#/$defs/hostNumber" },
            "availableBytes": { "$ref": "#/$defs/hostNumber" }
          }
        },
        "disks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mount", "filesystem", "totalBytes", "availableBytes"],
            "properties": {
              "mount": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "filesystem": { "$ref": "#/$defs/hostString" },
              "totalBytes": { "$ref": "#/$defs/hostNumber" },
              "availableBytes": { "$ref": "#/$defs/hostNumber" }
            }
          }
        },
        "interfaces": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "addresses", "mac", "state"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "mac": { "$ref": "#/$defs/hostString" },
              "state": { "enum": ["up", "down", "unknown"] },
              "addresses": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000]*$"
                }
              }
            }
          }
        }
      }
    },
    "host_info_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "host_info_request" },
        "id": { "$ref": "#/$defs/uuid" }
      }
    },
    "host_info_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "host_info_response" },
        "id": { "$ref": "#/$defs/uuid" },
        "error": { "type": "string", "pattern": "^[A-Z_]{1,64}$" },
        "result": { "$ref": "#/$defs/hostInformation" }
      },
      "oneOf": [
        { "required": ["error"], "not": { "required": ["result"] } },
        { "required": ["result"], "not": { "required": ["error"] } }
      ]
    },
    "remotePath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "remoteOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    },
    "remoteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "kind", "size", "modifiedAt", "mode"],
      "properties": {
        "name": { "$ref": "#/$defs/remotePath" },
        "path": { "$ref": "#/$defs/remotePath" },
        "kind": { "enum": ["directory", "file", "link", "other"] },
        "size": { "type": "integer", "minimum": 0 },
        "modifiedAt": { "type": "string" },
        "mode": { "type": "string" }
      }
    },
    "remoteDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "parent", "entries", "nextOffset"],
      "properties": {
        "path": { "$ref": "#/$defs/remotePath" },
        "parent": {
          "anyOf": [{ "$ref": "#/$defs/remotePath" }, { "type": "null" }]
        },
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/remoteEntry" }
        },
        "nextOffset": {
          "anyOf": [{ "$ref": "#/$defs/remoteOffset" }, { "type": "null" }]
        }
      }
    },
    "remoteFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "modifiedAt",
        "data",
        "offset",
        "nextOffset"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/remotePath" },
        "size": { "type": "integer", "minimum": 0 },
        "modifiedAt": { "type": "string" },
        "data": { "type": "string", "maxLength": 43692 },
        "offset": { "$ref": "#/$defs/remoteOffset" },
        "nextOffset": {
          "anyOf": [{ "$ref": "#/$defs/remoteOffset" }, { "type": "null" }]
        }
      }
    },
    "fs_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "operation", "path", "offset"],
      "properties": {
        "type": { "const": "fs_request" },
        "id": { "$ref": "#/$defs/uuid" },
        "operation": { "enum": ["list", "read"] },
        "path": { "$ref": "#/$defs/remotePath" },
        "offset": { "$ref": "#/$defs/remoteOffset" }
      }
    },
    "fs_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "fs_response" },
        "id": { "$ref": "#/$defs/uuid" },
        "error": { "type": "string", "pattern": "^[A-Z_]{1,64}$" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/remoteDirectory" },
            { "$ref": "#/$defs/remoteFile" }
          ]
        }
      },
      "oneOf": [
        { "required": ["error"], "not": { "required": ["result"] } },
        { "required": ["result"], "not": { "required": ["error"] } }
      ]
    },
    "terminal_open": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "session_id"],
      "properties": {
        "type": { "const": "terminal_open" },
        "session_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217728
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:\\/(?!\\/)|[A-Za-z]:[\\\\/])[^\\u0000*?\\r\\n]*$"
        }
      },
      "required": ["file_id", "name", "size_bytes", "sha256"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "data_b64": {
          "type": "string",
          "maxLength": 43692,
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "file": {
          "$ref": "#/$defs/file"
        },
        "encoding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": ["complete"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["data_b64"],
          "not": {
            "required": ["file"]
          }
        },
        {
          "required": ["file"],
          "not": {
            "required": ["data_b64"]
          }
        }
      ]
    },
    "hello": {
      "type": "object",
      "properties": {
        "installation_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "command_encoding": { "const": "base64" },
        "management": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "host_info": { "type": "boolean" },
        "uninstall": { "type": "boolean" },
        "shutdown": { "type": "boolean" },
        "relay": { "type": "boolean" },
        "type": {
          "const": "hello"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000]*$"
        },
        "os": {
          "enum": ["windows", "linux", "darwin"]
        },
        "arch": {
          "enum": ["amd64", "arm64", "386"]
        },
        "shells": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["powershell", "pwsh", "cmd", "sh", "bash", "zsh"]
          }
        },
        "hostname": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$"
        },
        "user": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": ["type", "version", "os", "arch", "shells"],
      "additionalProperties": false
    },
    "encoded_run": {
      "type": "object",
      "description": "Wire task. Decode command_b64 as canonical Base64, then UTF-8 JSON, and validate the reconstructed task against run. Never accept a plaintext command on the control channel.",
      "properties": {
        "type": { "const": "run" },
        "product": { "const": "WG-IR-Platform" },
        "task_id": { "$ref": "#/$defs/uuid" },
        "command_b64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 349528,
          "contentEncoding": "base64",
          "contentMediaType": "application/json",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "timeout_ms": { "$ref": "#/$defs/run/properties/timeout_ms" },
        "expires_at": { "$ref": "#/$defs/datetime" },
        "cwd": { "$ref": "#/$defs/run/properties/cwd" },
        "env": { "$ref": "#/$defs/run/properties/env" }
      },
      "required": [
        "type",
        "product",
        "task_id",
        "command_b64",
        "timeout_ms",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "type": {
          "const": "run"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "command": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "exec"
                },
                "program": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[^\\u0000]*$"
                },
                "args": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]*$"
                  }
                }
              },
              "required": ["kind", "program"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "script"
                },
                "shell": {
                  "enum": ["powershell", "pwsh", "cmd", "sh", "bash", "zsh"]
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32768,
                  "pattern": "^[^\\u0000]*$"
                },
                "args": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]*$"
                  }
                }
              },
              "required": ["kind", "shell", "content"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "collect"
                },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^(?:\\/(?!\\/)|[A-Za-z]:[\\\\/])[^\\u0000*?\\r\\n]*$"
                  }
                }
              },
              "required": ["kind", "paths"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "deploy"
                },
                "tool_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^[^\\\\/:\\u0000-\\u001f<>\"|?*]+$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500000000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "directory": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[^\\u0000-\\u001f]+$"
                }
              },
              "required": [
                "kind",
                "tool_id",
                "filename",
                "size_bytes",
                "sha256"
              ],
              "additionalProperties": false
            }
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000]*$"
        },
        "env": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^(?![Ww][Gg]_[Ii][Rr]_)[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "inputs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "string",
                "format": "uuid"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^:\\u0000]+$"
              }
            },
            "required": ["file_id", "sha256", "path"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "task_id", "command", "timeout_ms", "expires_at"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "properties": {
                  "kind": {
                    "const": "collect"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["cwd"]
                },
                {
                  "required": ["env"]
                },
                {
                  "required": ["inputs"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "properties": {
                  "kind": {
                    "const": "deploy"
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["cwd"]
                },
                {
                  "required": ["env"]
                },
                {
                  "required": ["inputs"]
                }
              ]
            }
          }
        }
      ]
    },
    "status": {
      "type": "object",
      "properties": {
        "type": {
          "const": "status"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "phase": {
          "enum": [
            "accepted",
            "running",
            "stopping",
            "transferring",
            "not_found"
          ]
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "transfer": {
          "$ref": "#/$defs/transfer"
        }
      },
      "required": ["type", "task_id"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["phase"]
        },
        {
          "required": ["error"]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": ["transfer"]
          },
          "then": {
            "required": ["phase"],
            "properties": {
              "phase": {
                "const": "transferring"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "type": {
          "const": "result"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": ["completed", "failed", "canceled", "timed_out", "unknown"]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "stdout": {
              "$ref": "#/$defs/output"
            },
            "stderr": {
              "$ref": "#/$defs/output"
            }
          },
          "required": ["stdout", "stderr"],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "signal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000]*$"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "file_errors": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?:\\/(?!\\/)|[A-Za-z]:[\\\\/])[^\\u0000*?\\r\\n]*$"
              },
              "message": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": ["path", "message"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "task_id",
        "state",
        "exit_code",
        "started_at",
        "finished_at",
        "output"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "enum": [0, null]
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "finished_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["error"]
                },
                {
                  "required": ["signal"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              }
            },
            "required": ["error"]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["failed", "canceled", "timed_out"]
              }
            }
          },
          "then": {
            "properties": {
              "finished_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            },
            "required": ["error"]
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "properties": {
        "type": {
          "const": "query"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "retry_files": {
          "const": true
        }
      },
      "required": ["type", "task_id"],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "type": {
          "const": "cancel"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": ["type", "task_id"],
      "additionalProperties": false
    },
    "ack": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ack"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "abandon_files": {
          "type": "boolean"
        },
        "reconciled": {
          "type": "boolean"
        }
      },
      "required": ["type", "task_id"],
      "additionalProperties": false
    },
    "transfer": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": ["uploading", "retrying", "failed"]
        },
        "sent_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217728
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "retry_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["file_id", "state", "sent_bytes"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "retrying"
              }
            }
          },
          "then": {
            "required": ["error", "retry_at"]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": ["error"]
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/connection_ready" },
    { "$ref": "#/$defs/relay_open" },
    { "$ref": "#/$defs/relay_error" },
    { "$ref": "#/$defs/uninstall_request" },
    { "$ref": "#/$defs/uninstall_response" },
    { "$ref": "#/$defs/shutdown_request" },
    { "$ref": "#/$defs/shutdown_response" },
    { "$ref": "#/$defs/host_info_request" },
    { "$ref": "#/$defs/host_info_response" },
    { "$ref": "#/$defs/fs_request" },
    { "$ref": "#/$defs/fs_response" },
    { "$ref": "#/$defs/terminal_open" },
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/encoded_run"
    },
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/query"
    },
    {
      "$ref": "#/$defs/cancel"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/ack"
    }
  ]
}
